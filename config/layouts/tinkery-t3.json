{
  "id": "root",
  "cloned_from": {
    "name": "herdr-t3",
    "version": "0.1.11"
  },
  "type": "row",
  "preview": "layouts/tinkery-t3.svg",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "t3-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "active": "lists",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "t3-spaces"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "tinkery-agent-list"
                  }
                }
              ]
            },
            {
              "id": "inbox",
              "type": "block",
              "content": {
                "mod": "tinkery-inbox",
                "props": {
                  "newMenu": "t3-new-menu"
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "t3-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 41
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "top-bar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "t3-tabs"
              }
            },
            {
              "id": "theme-toggle",
              "type": "block",
              "content": {
                "mod": "tinkery-theme"
              },
              "size": {
                "px": 120
              }
            }
          ],
          "size": {
            "px": 40
          },
          "resizable": false,
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "tinkery-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 4,
                  "lone": true
                }
              }
            }
          ],
          "padding": [
            0,
            2
          ],
          "gap": 4
        },
        {
          "id": "work-bottom-inset",
          "type": "row",
          "children": [],
          "size": {
            "px": 0
          }
        },
        {
          "id": "status",
          "type": "block",
          "hidden": true,
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_opacity": 0,
  "terminal_padding": [
    2,
    0
  ],
  "titlebar": "none",
  "traffic_lights": [
    16,
    13
  ]
}
